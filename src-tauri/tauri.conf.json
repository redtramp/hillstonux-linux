{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hillstonux-gui",
  "version": "0.1.0",
  "identifier": "com.hillstonux.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm build:daemon && pnpm dev",
    "beforeBuildCommand": "pnpm build:daemon && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Hillstonux",
        "width": 480,
        "height": 600,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "hillstonux-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Hillstonux VPN"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/hillstonux-daemon"],
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Hillstone Secure Connect VPN client",
    "longDescription": "GUI client for the Hillstone Secure Connect SSL VPN protocol. Targets KDE Plasma on Linux.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "librsvg2-2", "libssl3"]
      }
    }
  }
}
